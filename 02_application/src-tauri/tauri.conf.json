{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SC2 Adjutant Compose",
  "version": "1.1.11",
  "identifier": "com.dizerart.sc2companion.compose",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:compose-resources",
    "frontendDist": "../dist-renderer"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "SC2 Adjutant Compose",
      "width": 1469, "height": 860, "minWidth": 1000, "minHeight": 650,
      "decorations": false, "resizable": false, "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' http://voice-model.localhost voice-model: blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:*; frame-src 'self' http://127.0.0.1:*; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://voice-model.localhost voice-model:; worker-src 'self' blob:",
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../resources/compose-runtime/": "compose-runtime/",
      "../resources/map-bank/": "map-bank/",
      "../resources/voice-wasm/": "voice-wasm/",
      "../resources/voice-models/": "voice-models/",
      "../dist-obs/": "obs-web/"
    },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English", "Russian"], "displayLanguageSelector": true },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
