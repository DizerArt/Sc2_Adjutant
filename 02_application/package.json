{
  "name": "sc2-assistant-application",
  "version": "1.1.11",
  "private": true,
  "type": "module",
  "description": "Desktop-first SC2 opponent analysis application foundation.",
  "main": "dist-electron/main/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron scripts/electron-dev.cjs",
    "dev:poc": "tsx src/main/console-poc.ts",
    "diagnostics": "tsx src/main/diagnostics.ts",
    "build": "tsc --noEmit && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.electron.json && node scripts/copy-electron-assets.cjs",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win",
    "smoke:electron": "node scripts/electron-smoke.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "voice:download": "node scripts/download-voice-models.cjs",
    "voice:download:all": "node scripts/download-voice-models.cjs --all",
    "voice:wasm": "node scripts/copy-voice-wasm.cjs",
    "postinstall": "node scripts/copy-voice-wasm.cjs",
    "build:compose-resources": "tsc --noEmit && node scripts/build-compose-resources.cjs && vite build && vite build --config vite.obs.config.ts && node scripts/stage-postmatch-assets.cjs",
    "dev:compose": "npm run build:compose-resources && node scripts/compose.cjs dev",
    "build:compose": "node scripts/compose.cjs build",
    "check:compose": "node scripts/compose.cjs check",
    "test:compose": "node scripts/compose.cjs test",
    "fmt:compose": "node scripts/compose.cjs fmt",
    "clippy:compose": "node scripts/compose.cjs clippy",
    "stage:compose": "node scripts/stage-compose.cjs",
    "stage:compose-installer": "node scripts/stage-compose-installer.cjs",
    "smoke:compose": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-compose.ps1",
    "smoke:compat": "node scripts/smoke-compat.cjs",
    "build:obs": "vite build --config vite.obs.config.ts && node scripts/stage-postmatch-assets.cjs",
    "review:browser": "npm run build:compose-resources && node scripts/review-browser.cjs",
    "review:browser:serve": "node scripts/review-browser.cjs",
    "review:compose": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/review-compose.ps1",
    "test:review": "node --test scripts/review-browser.node-check.cjs"
  },
  "build": {
    "appId": "com.dizerart.sc2companion",
    "productName": "SC2 Adjutant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/voice-models",
        "to": "voice-models",
        "filter": [
          "**/*.onnx",
          "**/*.onnx.json"
        ]
      },
      {
        "from": "resources/voice-wasm",
        "to": "voice-wasm",
        "filter": [
          "**/*.wasm",
          "**/*.mjs",
          "**/*.data",
          "**/*.js"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/main/electron/main.js"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "@replaysremastered/sc2readerjs": "^0.1.9",
    "@tauri-apps/api": "^2.12.4",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "fast-xml-parser": "^5.8.0",
    "onnxruntime-web": "^1.26.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.2",
    "vitest": "^3.1.2",
    "wait-on": "^9.0.5"
  }
}
