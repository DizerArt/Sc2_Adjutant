{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-electron",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "src/main/**/*",
    "src/application/**/*",
    "src/domain/**/*",
    "src/infrastructure/**/*",
    "src/shared/**/*"
  ],
  "exclude": ["src/renderer/**/*", "tests/**/*"]
}
